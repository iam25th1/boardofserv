# Copy to .env.local and fill in. .env.local is gitignored and never shipped.
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server only.

# Privy. The app id is public (it is in the client bundle by design). The app
# secret is server only and must never be exposed.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# 32-byte key, base64, for encrypting each user's OpenServ key at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPENSERV_KEY_ENC_KEY=

# Postgres (local Docker default below).
DATABASE_URL=postgres://boardofserv:boardofserv@localhost:5433/boardofserv

# OpenServ platform (wallet linking and the account's credit state).
OPENSERV_API_URL=https://api.openserv.ai

# SERV Reasoning answers the chat. Server only.
SERV_API_KEY=

# Dolphin, the chat's second model, tried when SERV fails before its first
# token. Blank key means no Dolphin. Base url and model default to the ones
# https://dphn.ai/docs/dphn-api lists. Helper uses never go to Dolphin.
DOLPHIN_API_KEY=
DOLPHIN_BASE_URL=https://lighthouse.dphn.ai/run/text-v/v1
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Backup model, tried last, when SERV and Dolphin fail before their first
# token (network error, timeout, 5xx, 429 or 402). Any OpenAI-compatible
# endpoint: base url, key and model name are all needed. Leave blank for no
# backup.
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=gpt-4o-mini
FALLBACK_LABEL=GPT-4o mini

# Optional. How long a model may stay silent before its first token, or
# between chunks after it, before the reply moves on or is cut off.
MODEL_FIRST_TOKEN_TIMEOUT_MS=20000

# Optional usage limits: how many recent messages go to the model with the
# system prompt (older ones are dropped), and the most tokens a reply may use.
CHAT_HISTORY_MESSAGES=12
CHAT_MAX_TOKENS=700

# Optional spend protection. Each person may send CHAT_DAILY_LIMIT messages a
# day (default 30). DAILY_SPEND_LIMIT_USD (default 5) is the most the site
# spends a day on the operator's model keys, estimated from recorded tokens:
# once reached, chat, publishing and helper uses pause until midnight UTC for
# everyone but people using their own SERV key.
CHAT_DAILY_LIMIT=30
DAILY_SPEND_LIMIT_USD=5

# Optional. Building agents: the most tokens SERV's plan may use, how long a
# plan may take (one answer of a few thousand tokens, not streamed), and how
# long Dolphin may take to write one code step.
AGENT_PLAN_MAX_TOKENS=3500
AGENT_PLAN_TIMEOUT_MS=120000
DOLPHIN_CODE_TIMEOUT_MS=240000

# Optional. Agents running for real: 0 stops the server's job worker (no
# triggers fire, no jobs run) in this process, and how many pages each
# installation may fetch a day.
BOS_AGENT_WORKER=
AGENT_FETCHES_PER_DAY=100

# Optional. Safeguards on agents running for real (README, Safeguards).
# Model budgets in USDC a week: the default for an installation (makers can
# set their own), the most anyone may set, and what the platform pays for a
# free agent's model calls. Schedules never run more often than
# AGENT_MIN_INTERVAL_MINUTES. Per installation: jobs and messages to its
# renter an hour, actions a job, visits to one step a job, and jobs in a row
# failing the same way before it pauses.
AGENT_MODEL_BUDGET_USDC=1
AGENT_MODEL_BUDGET_CEILING_USDC=5
AGENT_FREE_MODEL_ALLOWANCE_USDC=0.25
AGENT_MIN_INTERVAL_MINUTES=15
AGENT_JOBS_PER_HOUR=12
AGENT_OUTBOUND_PER_HOUR=20
AGENT_ACTIONS_PER_JOB=40
AGENT_STEP_VISITS=12
AGENT_SAME_FAILURES=3

# Reppo's Eval Router (https://eval.reppo.xyz/api-key), for quality scores
# of a sample of finished jobs and second opinions on payments and new
# contacts. Blank means off. The key is sent to Reppo's own address only.
# Sampling: the first REPPO_FIRST_JOBS jobs of each new version, then one in
# REPPO_SAMPLE_EVERY, at most REPPO_AGENT_WEEKLY_CAP a week for each agent,
# within REPPO_DAILY_CREDITS a day for the whole site (440 an evaluation).
# REPPO_ACTION_OPINIONS=0 turns second opinions off. A version shows a score
# after REPPO_MIN_SCORED reviewed jobs, from its latest REPPO_SCORE_WINDOW;
# REPPO_HOLD_BLOCKS blocks within REPPO_HOLD_DAYS put its listing on hold.
REPPO_API_KEY=
REPPO_FIRST_JOBS=3
REPPO_SAMPLE_EVERY=10
REPPO_AGENT_WEEKLY_CAP=10
REPPO_DAILY_CREDITS=4400
REPPO_ACTION_OPINIONS=1
REPPO_MIN_SCORED=5
REPPO_SCORE_WINDOW=30
REPPO_HOLD_BLOCKS=3
REPPO_HOLD_DAYS=7

# Telegram: the bot owners link their chat to (from @BotFather). Agents
# message owners and ask them things there, with buttons. Blank means
# in-app only. The webhook is set by scripts/telegram-webhook.ts after a
# deploy, never by the server; its secret is kept as a hash in the database.
# TELEGRAM_DEV_WEBHOOK_SECRET is for development only (it is ignored in
# production): the secret scripts/telegram-fake-update.ts sends a local
# server. APP_URL is the site's public address (default
# https://boardofserv.25th.dev), for the webhook and Google's callback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEV_WEBHOOK_SECRET=
APP_URL=

# Google, for owners' Google Sheets: an OAuth client of type "Web
# application" whose authorized redirect URI is APP_URL plus
# /api/connections/google/callback. It asks for the spreadsheets scope (a
# sensitive scope: until the app is verified Google shows an unverified-app
# warning, and in Testing mode only listed test users can connect, for 7
# days at a time). Blank means no Google Sheets. AGENT_SHEET_CALLS_PER_DAY
# (default 500) is how many sheet reads and writes each installation may
# make a day.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AGENT_SHEET_CALLS_PER_DAY=

# Brave Search, for agents' web.search (api-dashboard.search.brave.com).
# Blank means no web search. Each installation may search
# AGENT_SEARCHES_PER_DAY times a day (default 50) and the whole site
# SITE_SEARCHES_PER_DAY times (default 1000). Brave bills $5 per 1,000
# searches past its monthly free credit.
BRAVE_SEARCH_API_KEY=
AGENT_SEARCHES_PER_DAY=
SITE_SEARCHES_PER_DAY=

# Optional. What each model costs, in US dollars per million tokens, for the
# daily spend estimate. SERV's default is the price servpit found, Dolphin's
# is from its docs. The backup is priced like SERV unless set.
SERV_PRICE_INPUT_PER_M=1.25
SERV_PRICE_OUTPUT_PER_M=6.5
DOLPHIN_PRICE_INPUT_PER_M=0.01
DOLPHIN_PRICE_OUTPUT_PER_M=0.07
FALLBACK_PRICE_INPUT_PER_M=1.25
FALLBACK_PRICE_OUTPUT_PER_M=6.5

# Payments. Off until TREASURY_ADDRESS is set. Base Sepolia unless
# BOS_NETWORK=base, and Base mainnet also needs BOS_MAINNET=1.
BOS_NETWORK=base-sepolia
BOS_MAINNET=
# Optional RPC endpoint. Blank uses the network's public one.
BOS_RPC_URL=
# The wallet users deposit to and payouts come from. The address is public.
TREASURY_ADDRESS=
# Server only, and only needed to pay withdrawals. Never commit or log it.
TREASURY_PRIVATE_KEY=
# USDC defaults to Circle's address for the network, 6 decimals.
USDC_TOKEN_ADDRESS=
USDC_DECIMALS=
USDC_ENABLED=1
# SERV stays off until both are set. Check them against docs.openserv.ai.
SERV_TOKEN_ADDRESS=
SERV_TOKEN_DECIMALS=
SERV_ENABLED=1
# Deposits: confirmations before a credit, how often the watcher scans (ms),
# blocks per log query, and the block to start from on the very first scan.
# Base's public RPC refuses a log query over more than 201 blocks, so keep the
# chunk at 200 or below unless BOS_RPC_URL names a provider that allows more.
DEPOSIT_CONFIRMATIONS=5
DEPOSIT_SCAN_INTERVAL_MS=30000
DEPOSIT_SCAN_CHUNK=200
DEPOSIT_START_BLOCK=
# 0 stops the server's payments interval (the watcher, the hold sweep and
# payouts). "Check for my deposit" still scans.
BOS_PAYMENTS_WORKER=
# Withdrawals, in whole tokens (decimals allowed). Below the auto max a
# withdrawal is paid without approval while the day's automatic total stays
# within the daily cap. 0 means every withdrawal waits for approval.
WITHDRAW_MIN_USDC=5
WITHDRAW_AUTO_MAX_USDC=0
WITHDRAW_DAILY_CAP_USDC=0
WITHDRAW_MIN_SERV=
WITHDRAW_AUTO_MAX_SERV=0
WITHDRAW_DAILY_CAP_SERV=0
# Who may open /admin: boardofserv user ids or Privy user ids, comma separated.
# Admins are always let in, whatever INVITE_ONLY says.
ADMIN_USER_IDS=

# Invite-only, on unless set to 0, false, no or off. Every account starts out
# waiting and sees the waitlist until an admin approves it on /admin. The
# board and helper pages stay open to everyone.
INVITE_ONLY=1
