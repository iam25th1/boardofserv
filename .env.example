# Copy to .env.local and fill in. .env.local is gitignored and never shipped.
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server only.
# A blank optional value means its default (or off, where that is said).
# Values below are placeholders or defaults, never real credentials.

# ---- Sign-in (Privy) ----
# Privy app id. Public: it is in the client bundle by design.
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy app secret. Server only, never exposed.
PRIVY_APP_SECRET=

# ---- Storage ----
# 32-byte base64 key that encrypts each user's OpenServ key at rest: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPENSERV_KEY_ENC_KEY=
# Postgres. This is the local Docker default (docker-compose.yml, 127.0.0.1 only); any shared or production database needs its own password.
DATABASE_URL=postgres://boardofserv:boardofserv@localhost:5433/boardofserv

# ---- OpenServ and models ----
# OpenServ platform API, for wallet linking and the account's credit state.
OPENSERV_API_URL=https://api.openserv.ai
# SERV Reasoning key: chat, plans, reviews and the fixer. Server only.
SERV_API_KEY=
# Dolphin key, the second model (writes agents' code; chat fallback). Blank means no Dolphin.
DOLPHIN_API_KEY=
# Dolphin's OpenAI-compatible base URL (https://dphn.ai/docs/dphn-api).
DOLPHIN_BASE_URL=https://lighthouse.dphn.ai/run/text-v/v1
# Dolphin's model name.
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Backup model's OpenAI-compatible base URL, tried last when SERV and Dolphin fail before their first token.
FALLBACK_BASE_URL=https://api.openai.com/v1
# Backup model's key. Blank means no backup.
FALLBACK_API_KEY=
# Backup model's name.
FALLBACK_MODEL=gpt-4o-mini
# Backup model's name as people see it.
FALLBACK_LABEL=GPT-4o mini
# Optional. How long (ms) a model may stay silent before its first token, or between chunks, before it is cut off.
MODEL_FIRST_TOKEN_TIMEOUT_MS=20000
# Optional. Tries per provider for one model call (out of credit is never retried).
MODEL_RETRY_ATTEMPTS=3
# Optional. Pause (ms) before the second try; the third waits twice as long.
MODEL_RETRY_BACKOFF_MS=500

# ---- Answer sizes (every other limit is in src/lib/modelLimits.ts) ----
# Optional. Recent messages sent to the model with the system prompt.
CHAT_HISTORY_MESSAGES=12
# Optional. Most tokens a chat reply may use.
CHAT_MAX_TOKENS=700
# Optional. Most tokens a sketch (a first plan in chat) may use. Blank uses modelLimits.ts.
SKETCH_MAX_TOKENS=
# Optional. Most tokens a helper's compiled prompt may use. Blank uses modelLimits.ts.
COMPILE_MAX_TOKENS=
# Optional. Most tokens SERV's agent plan may use.
AGENT_PLAN_MAX_TOKENS=3500
# Optional. How long (ms) one agent plan may take.
AGENT_PLAN_TIMEOUT_MS=120000
# Optional. How long (ms) Dolphin may take to write one code step.
DOLPHIN_CODE_TIMEOUT_MS=240000

# ---- Spend protection ----
# Optional. Chat messages each person may send a day.
CHAT_DAILY_LIMIT=30
# Optional. Most the site spends a day (USD, estimated) on the operator's model keys; past it, model use pauses until midnight UTC.
DAILY_SPEND_LIMIT_USD=5
# Optional. Free helper uses each person gets a day (default 20). Paid uses don't count.
HELPER_DAILY_USES=
# Optional. Repair rounds one build may take healing itself (default 3).
AGENT_HEAL_ROUNDS=
# Optional. Most one build's model calls may cost, USD (default grows with the agent's size).
AGENT_BUILD_COST_USD=
# Optional. boardofserv's own model calls a day (reviews, screening, outside runs), USDC. Past it they wait.
PLATFORM_MODEL_BUDGET_USDC=2
# Optional. SERV's price per million input tokens (USD), for the daily spend estimate.
SERV_PRICE_INPUT_PER_M=1.25
# Optional. SERV's price per million output tokens (USD).
SERV_PRICE_OUTPUT_PER_M=6.5
# Optional. Dolphin's price per million input tokens (USD).
DOLPHIN_PRICE_INPUT_PER_M=0.01
# Optional. Dolphin's price per million output tokens (USD).
DOLPHIN_PRICE_OUTPUT_PER_M=0.07
# Optional. Backup model's price per million input tokens (USD); priced like SERV unless set.
FALLBACK_PRICE_INPUT_PER_M=1.25
# Optional. Backup model's price per million output tokens (USD).
FALLBACK_PRICE_OUTPUT_PER_M=6.5

# ---- Agents running for real (docs/DEVELOPMENT.md, Safeguards) ----
# Optional. 0 stops the job worker in this process (no triggers fire, no jobs run).
BOS_AGENT_WORKER=
# Optional. Pages each installation may fetch a day.
AGENT_FETCHES_PER_DAY=100
# Optional. Default weekly model budget for an installation, USDC (makers can set their own).
AGENT_MODEL_BUDGET_USDC=1
# Optional. Most anyone may set as a weekly model budget, USDC.
AGENT_MODEL_BUDGET_CEILING_USDC=5
# Optional. What the platform pays a week for a free agent's model calls, USDC.
AGENT_FREE_MODEL_ALLOWANCE_USDC=0.25
# Optional. Schedules never run more often than this, minutes.
AGENT_MIN_INTERVAL_MINUTES=15
# Optional. Jobs an installation may run an hour.
AGENT_JOBS_PER_HOUR=12
# Optional. Messages an installation may send its renter an hour.
AGENT_OUTBOUND_PER_HOUR=20
# Optional. Actions one job may take.
AGENT_ACTIONS_PER_JOB=40
# Optional. Visits one job may make to a single step.
AGENT_STEP_VISITS=12
# Optional. Jobs in a row failing the same way before the installation pauses.
AGENT_SAME_FAILURES=3

# ---- Reppo quality scores and second opinions (https://eval.reppo.xyz/api-key) ----
# Reppo key. Blank turns scores and second opinions off. Sent to reppo.xyz only.
REPPO_API_KEY=
# Optional. Reppo's API base; must be https on reppo.xyz, anything else is ignored.
REPPO_BASE_URL=
# Optional. First jobs of each new version that are always scored.
REPPO_FIRST_JOBS=3
# Optional. After those, one job in this many is scored.
REPPO_SAMPLE_EVERY=10
# Optional. Most scored jobs a week for each agent.
REPPO_AGENT_WEEKLY_CAP=10
# Optional. Reppo credits the whole site may use a day (440 per evaluation).
REPPO_DAILY_CREDITS=4400
# Optional. 0 turns second opinions on payments and new contacts off.
REPPO_ACTION_OPINIONS=1
# Optional. Reviewed jobs before a version shows a score.
REPPO_MIN_SCORED=5
# Optional. How many of a version's latest jobs its score is taken from.
REPPO_SCORE_WINDOW=30
# Optional. Blocks within REPPO_HOLD_DAYS that put a listing on hold.
REPPO_HOLD_BLOCKS=3
# Optional. The window for REPPO_HOLD_BLOCKS, days.
REPPO_HOLD_DAYS=7

# ---- Telegram (agents message owners and ask them things, with buttons) ----
# Bot token from @BotFather. Blank means in-app messages only. The webhook is set by scripts/telegram-webhook.ts.
TELEGRAM_BOT_TOKEN=
# Development only (ignored in production): the webhook secret scripts/telegram-fake-update.ts sends a local server.
TELEGRAM_DEV_WEBHOOK_SECRET=
# The site's public address, for the Telegram webhook and Google's callback (default https://boardofserv.25th.dev).
APP_URL=

# ---- Google Sheets ----
# OAuth "Web application" client id; its redirect URI is APP_URL + /api/connections/google/callback. Blank means no Sheets.
GOOGLE_CLIENT_ID=
# OAuth client secret. Server only.
GOOGLE_CLIENT_SECRET=
# Optional. Sheet reads and writes each installation may make a day (default 500).
AGENT_SHEET_CALLS_PER_DAY=

# ---- Brave Search (agents' web.search, api-dashboard.search.brave.com) ----
# Brave Search key. Blank means no web search.
BRAVE_SEARCH_API_KEY=
# Optional. Searches each installation may make a day (default 50).
AGENT_SEARCHES_PER_DAY=
# Optional. Searches the whole site may make a day (default 1000).
SITE_SEARCHES_PER_DAY=

# ---- Payments (off until TREASURY_ADDRESS is set; Base Sepolia test money) ----
# Network: base-sepolia. base also needs BOS_MAINNET=1; leave both alone for the beta.
BOS_NETWORK=base-sepolia
# Leave blank. 1 allows Base mainnet deposits and withdrawals (real money).
BOS_MAINNET=
# Optional. RPC endpoint; blank uses the network's public one.
BOS_RPC_URL=
# The treasury wallet's address: users deposit to it and payouts come from it. Public.
TREASURY_ADDRESS=
# The treasury's private key. Server only, read only by the payout signer. Never commit or log it.
TREASURY_PRIVATE_KEY=
# Optional. USDC contract; blank uses Circle's address for the network.
USDC_TOKEN_ADDRESS=
# Optional. USDC decimals (default 6).
USDC_DECIMALS=
# 1 takes USDC.
USDC_ENABLED=1
# SERV token contract. SERV stays off until this and SERV_TOKEN_DECIMALS are set (check docs.openserv.ai).
SERV_TOKEN_ADDRESS=
# SERV token decimals.
SERV_TOKEN_DECIMALS=
# 1 takes SERV once its address and decimals are set.
SERV_ENABLED=1
# Optional. Confirmations before a deposit is credited.
DEPOSIT_CONFIRMATIONS=5
# Optional. How often the deposit watcher scans, ms.
DEPOSIT_SCAN_INTERVAL_MS=30000
# Optional. Blocks per log query; Base's public RPC refuses more than 201.
DEPOSIT_SCAN_CHUNK=200
# Optional. Block the very first deposit scan starts from.
DEPOSIT_START_BLOCK=
# Optional. 0 stops the payments interval in this process (watcher, hold sweep, payouts).
BOS_PAYMENTS_WORKER=
# Optional. Least USDC one withdrawal may be.
WITHDRAW_MIN_USDC=5
# Optional. USDC withdrawals up to this are paid without approval (0: every one waits).
WITHDRAW_AUTO_MAX_USDC=0
# Optional. Most USDC paid without approval in a day.
WITHDRAW_DAILY_CAP_USDC=0
# Optional. Least SERV one withdrawal may be.
WITHDRAW_MIN_SERV=
# Optional. SERV withdrawals up to this are paid without approval (0: every one waits).
WITHDRAW_AUTO_MAX_SERV=0
# Optional. Most SERV paid without approval in a day.
WITHDRAW_DAILY_CAP_SERV=0

# ---- Agents' payments (renter-funded allowances, saved payees, test USDC) ----
# Optional. Most one installation's allowance may hold, USDC.
AGENT_ALLOWANCE_MAX_USDC=100
# Optional. Least the treasury keeps, USDC; below it agent payments pause site wide.
AGENT_PAYMENTS_MIN_TREASURY_USDC=5
# Optional. Most all agents together pay in a day (UTC), USDC.
AGENT_PAYMENTS_SITE_DAILY_USDC=1000
# Never set. Agent payments refuse any mainnet chain, RPC or USDC address unless this is 1.
AGENT_PAYMENTS_MAINNET=
# Optional. Block reconciliation starts from the first time; blank starts at the chain's head.
AGENT_RECONCILE_START_BLOCK=
# Optional. Days after a payment or a week's rent that a renter may dispute it (1 to 90).
DISPUTE_WINDOW_DAYS=14
# Optional. Other renters saving the same payee address before it counts as crowded (always asks, with a warning).
PAYEE_CROWD_RENTERS=3

# ---- Access and support ----
# Who may open /admin: boardofserv or Privy user ids, comma separated. Blank means nobody.
ADMIN_USER_IDS=
# Invite-only, on unless 0, false, no or off: new accounts wait until an admin approves them. Admins always get in.
INVITE_ONLY=1
# Optional. The support page's email line, read at build time; blank points people to Telegram.
SUPPORT_EMAIL=
