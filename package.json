{
  "name": "boardofserv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:build": "CHECK_BUILD=1 vitest run src/test/demo-unreachable.test.ts src/test/production.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:deploy": "vite-node scripts/db-push.ts",
    "db:up": "sh scripts/db.sh up",
    "db:down": "sh scripts/db.sh down",
    "testnet-smoke": "vite-node --config vitest.config.ts scripts/testnet-smoke.ts",
    "gate": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:build",
    "start:prod": "next start --hostname 127.0.0.1 --port 7560"
  },
  "dependencies": {
    "@privy-io/react-auth": "2.13.1",
    "@privy-io/server-auth": "1.18.4",
    "animejs": "4.5.0",
    "drizzle-orm": "0.36.4",
    "next": "14.2.15",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "viem": "2.21.45",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "drizzle-kit": "0.28.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "happy-dom": "15.11.6",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
